PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restart
AUTO_MIGRATE=true

JWT_SECRET=change-moi-avec-une-cle-longue-et-secrete
JWT_EXPIRES_IN=7d

# URL publique du backend et URL principale du frontend.
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5173
# Plusieurs origines CORS possibles, séparées par des virgules.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Une clé fonctionne encore. Pour la rotation automatique, ajoutez jusqu'à 5 clés séparées par des virgules.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash

# SMTP : Gmail nécessite généralement un mot de passe d'application.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RE:START <no-reply@restart.local>

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/oauth/google/callback

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/oauth/github/callback
