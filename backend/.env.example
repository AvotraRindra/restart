PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leboot_restart
AUTO_MIGRATE=true

JWT_SECRET=change-moi-avec-une-cle-longue-et-secrete
JWT_EXPIRES_IN=7d

# Convention Hodifly : frontend = lien.de.frontend / backend = api.lien.de.frontend
BACKEND_PUBLIC_URL=https://api.lien.de.frontend
FRONTEND_PUBLIC_URL=https://lien.de.frontend
FRONTEND_URL=https://lien.de.frontend

GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Rotation automatique de jusqu'à 5 clés Gemini.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RE:START <votre-adresse@gmail.com>

# OAuth Google uniquement
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.lien.de.frontend/api/auth/oauth/google/callback
